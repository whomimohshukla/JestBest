# ── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_ORIGIN=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://jestbest:jestbest@localhost:5432/jestbest?schema=public

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=jestbest:

# ── Auth / JWT ─────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=jestbest

# Lifetime of the emailed single-use password reset token
PASSWORD_RESET_EXPIRES_IN=1h

# ── Encryption (AES-256-GCM key, 32 bytes hex) ─────────────────────────
# WARNING: generate a fresh key per environment: `openssl rand -hex 32`
ENCRYPTION_KEY=change-me-32-byte-hex-key-generated-by-openssl-rand-hex-32

# ── CORS / Security ────────────────────────────────────────────────────
CORS_ORIGINS=*
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ── AWS S3 ─────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=jestbest-artifacts
AWS_S3_ENDPOINT=

# ── LLM ────────────────────────────────────────────────────────────────
# AI provider: openai | gemini | huggingface | mock (mock = offline, no key needed)
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# ── Billing ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Integrations ───────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/integrations/github/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# --- Email (outbound) ---
# log      = print to stdout (default, good for local dev)
# smtp     = real delivery via nodemailer
# sendgrid = real delivery via the SendGrid API
# ses      = not implemented
EMAIL_PROVIDER=log
EMAIL_FROM=notifications@jestbest.ai
# Required when EMAIL_PROVIDER=smtp. Gmail needs an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
