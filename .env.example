# ── App ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# The SPA's origin. Used for CORS, emailed links and the OAuth redirect.
APP_ORIGIN=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# This API's own public base URL. Needed to build the OAuth callback URI, which
# must point back at the server that exchanges the provider code — pointing it
# at the SPA origin makes GitHub redirect somewhere that cannot finish sign-in.
API_ORIGIN=http://localhost:4000

# ── Database ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://jestbest:jestbest@localhost:5432/jestbest?schema=public

# ── Redis ──────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=jestbest:

# ── Auth / JWT ─────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=jestbest

# When true, login is blocked until the emailed verification link is clicked.
# Set to true in production; false keeps local development free of inbox hops.
REQUIRE_EMAIL_VERIFICATION=false

# Lifetime of the emailed single-use password reset token
PASSWORD_RESET_EXPIRES_IN=1h

# ── Encryption (AES-256-GCM key, 32 bytes hex) ─────────────────────────
# WARNING: generate a fresh key per environment: `openssl rand -hex 32`
ENCRYPTION_KEY=change-me-32-byte-hex-key-generated-by-openssl-rand-hex-32

# ── CORS / Security ────────────────────────────────────────────────────
CORS_ORIGINS=*
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# Tighter budget for login / register / password reset, per IP.
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# ── AWS S3 ─────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=jestbest-artifacts
AWS_S3_ENDPOINT=

# ── LLM ────────────────────────────────────────────────────────────────
# AI provider: openai | gemini | huggingface | mock (mock = offline, no key needed)
AI_PROVIDER=mock
# Providers tried in order when the primary one's request fails (ends with the
# offline mock automatically). Empty = provider-aware defaults, e.g. for gemini:
# huggingface,openai. Set a HUGGINGFACE_API_KEY to enable the open-source fallback.
AI_FALLBACK_PROVIDERS=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# ── Billing ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Integrations ───────────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/github/callback
# Google OAuth (login + signup). Create an OAuth client at Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_OAUTH_CALLBACK_URL below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/google/callback
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# --- Email (outbound) ---
# log      = print to stdout (default, good for local dev)
# smtp     = real delivery via nodemailer
# sendgrid = real delivery via the SendGrid API
# ses      = not implemented
EMAIL_PROVIDER=log
EMAIL_FROM=notifications@jestbest.ai
# Required when EMAIL_PROVIDER=smtp. Gmail needs an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Required when EMAIL_PROVIDER=sendgrid.
SENDGRID_API_KEY=

# Where EMAIL_PROVIDER=log writes messages so you can read the links locally.
EMAIL_INBOX_FILE=.dev-mailbox.log

# ── Seed (npm run seed) ────────────────────────────────────────────────
# Credentials for the bootstrap admin created by the seed script.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Set to 1 (or run `npm run seed:demo`) to also seed a demo workspace:
# a project, 5 test cases, 8 runs over the last 2 weeks, a bug backlog and
# usage rows, so the dashboard/billing pages have data on a fresh install.
# The demo account is <SEED_ADMIN_EMAIL> or demo@jestbest.dev with password
# DemoPassword123! — change both before deploying anywhere shared.
SEED_DEMO_DATA=
