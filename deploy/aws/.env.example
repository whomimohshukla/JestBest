# ── AWS EC2 deployment environment ────────────────────────────────────────────
# Copy to `.env` on the instance (never commit it):
#   cp .env.example .env
# Generate the three secrets with:
#   openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────────

# The public HTTPS hostname Caddy serves. Use <public-ip-with-dashes>.sslip.io
# (resolves to that IP, no domain purchase, Let's Encrypt works). Example for
# IP 203.0.113.10:
API_DOMAIN=203-0-113-10.sslip.io

NODE_ENV=production
PORT=4000

# Neon pooled connection string. Append ?sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Redis runs in the compose stack. To use Upstash instead, point this at the
# rediss:// URL (note the double s) and delete the redis service from compose.
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=jestbest:

# Required secrets — each must be unique and at least 16 chars (ENCRYPTION_KEY
# at least 32). Generate with `openssl rand -hex 32`.
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me
ENCRYPTION_KEY=replace-me

# Public URLs. FRONTEND_ORIGIN/CORS_ORIGINS must be the exact Vercel origin.
APP_ORIGIN=https://your-app.vercel.app
FRONTEND_ORIGIN=https://your-app.vercel.app
API_ORIGIN=https://203-0-113-10.sslip.io
CORS_ORIGINS=https://your-app.vercel.app

# Keep the demo self-contained and free; no paid AI or email provider needed.
AI_PROVIDER=mock
EMAIL_PROVIDER=log
REQUIRE_EMAIL_VERIFICATION=false
LOG_LEVEL=info

# Optional OAuth (leave blank to show the buttons but disable sign-in).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://203-0-113-10.sslip.io/api/v1/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://203-0-113-10.sslip.io/api/v1/auth/oauth/google/callback

# Demo admin seeded into Neon by `npx prisma db seed` (run once from your laptop).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password
